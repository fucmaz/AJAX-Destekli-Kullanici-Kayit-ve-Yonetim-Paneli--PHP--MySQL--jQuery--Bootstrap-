Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "^(bootstrap\.php|config\.local\.php|db\.php)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^sql/ - [F,L]
  RewriteRule ^tests/ - [F,L]
  RewriteRule ^config\.local\.php$ - [F,L]
</IfModule>
